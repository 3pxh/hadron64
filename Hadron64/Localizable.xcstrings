    "Training and multiplayer are unlimited. Your support keeps the game going." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التدريب واللعب الجماعي بلا حدود الآن. دعمك يُبقي اللعبة مستمرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training und Mehrspieler sind unbegrenzt. Deine Unterstützung hält das Spiel am Leben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento y el multijugador son ilimitados. Tu apoyo mantiene vivo el juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entraînement et le multijoueur sont illimités. Votre soutien fait vivre le jeu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभ्यास और मल्टीप्लेयर अब असीमित हैं। आपका समर्थन गेम को चलाए रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latihan dan multipemain kini tanpa batas. Dukunganmu membuat game ini terus berjalan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenamento e multigiocatore sono illimitati. Il tuo sostegno mantiene vivo il gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレーニングとマルチプレイが無制限になりました。あなたの応援がゲームを支えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훈련과 멀티플레이가 무제한입니다. 여러분의 후원이 게임을 이어 갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainen en multiplayer zijn onbeperkt. Jouw steun houdt het spel in leven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trening i gra wieloosobowa są bez limitu. Twoje wsparcie utrzymuje grę przy życiu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino e multijogador estão ilimitados. Seu apoio mantém o jogo vivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировки и мультиплеер без ограничений. Ваша поддержка помогает игре жить."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การฝึกซ้อมและโหมดหลายผู้เล่นไม่จำกัดแล้ว การสนับสนุนของคุณช่วยให้เกมนี้ดำเนินต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antrenman ve çok oyunculu mod sınırsız. Desteğin oyunu ayakta tutuyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренування та мультиплеєр без обмежень. Ваша підтримка допомагає грі жити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luyện tập và chế độ nhiều người đã không giới hạn. Sự ủng hộ của bạn giúp trò chơi tiếp tục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练和多人模式已无限制。你的支持让游戏得以继续。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訓練與多人模式已無限制。你的支持讓遊戲得以延續。"
          }
        }
      }
    },
