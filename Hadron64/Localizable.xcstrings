    "A one-time purchase supports the game and unlocks unlimited training and multiplayer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شراء لمرة واحدة يدعم اللعبة ويفتح التدريب واللعب الجماعي بلا حدود."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein einmaliger Kauf unterstützt das Spiel und schaltet unbegrenztes Training und Mehrspieler frei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una compra única apoya el juego y desbloquea entrenamiento y multijugador ilimitados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un achat unique soutient le jeu et débloque l'entraînement et le multijoueur en illimité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार की ख़रीद गेम का समर्थन करती है और असीमित अभ्यास और मल्टीप्लेयर अनलॉक करती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembelian satu kali mendukung game ini dan membuka latihan serta multipemain tanpa batas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un acquisto una tantum sostiene il gioco e sblocca allenamento e multigiocatore illimitati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度きりの購入でゲームを応援でき、トレーニングとマルチプレイが無制限になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번의 구매로 게임을 후원하고 훈련과 멀티플레이를 무제한으로 즐길 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een eenmalige aankoop steunt het spel en ontgrendelt onbeperkt trainen en multiplayer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednorazowy zakup wspiera grę i odblokowuje nielimitowany trening oraz grę wieloosobową."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma compra única apoia o jogo e libera treino e multijogador ilimitados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разовая покупка поддерживает игру и открывает неограниченные тренировки и мультиплеер."
          }
        },
        "th" : {
          "stringUnit" : {
